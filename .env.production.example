# ---------------------------------------------------------------------------
# Production environment variables for Mans ERP.
#
# This file documents every variable required to run the application in
# production. Copy it to `.env.production` on your production host and fill
# in real values there — never commit `.env.production`, and never put real
# secrets in this example file.
#
# See deployment.md for how these are used during deployment.
# ---------------------------------------------------------------------------

# =============================================================================
# PostgreSQL
# =============================================================================
# Use a managed/production-grade Postgres instance (not the dev container).
# DATABASE_URL is consumed directly by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# =============================================================================
# api-server
# =============================================================================
NODE_ENV=production
PORT=8080

# Comma-separated list of origins allowed to call the API (CORS allowlist).
# Must include the exact production URL(s) the frontend is served from.
CORS_ALLOWED_ORIGINS=https://your-production-domain.example

# Clerk authentication — server-side. Use a PRODUCTION Clerk instance's keys
# (not the same keys used in development).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Logging verbosity (trace|debug|info|warn|error|fatal). "info" recommended
# for production.
LOG_LEVEL=info

# Optional rate limiting overrides. Defaults are used if unset — see
# artifacts/api-server/src/middlewares/rateLimiter.ts.
# RATE_LIMIT_GENERAL_MAX=600
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_WRITE_MAX=200
# RATE_LIMIT_WRITE_WINDOW_MS=900000
# RATE_LIMIT_SENSITIVE_MAX=60
# RATE_LIMIT_SENSITIVE_WINDOW_MS=900000

# Object storage (file attachments). This app uses Replit's App Storage
# sidecar, which is only available when running inside a Replit deployment.
# If deploying outside Replit, this feature requires a compatible
# replacement — see deployment.md "Object storage" section.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# =============================================================================
# mans-erp (frontend)
# =============================================================================
PORT=8081

# Base path the app is served under. Use "/" unless deployed behind a path
# prefix.
BASE_PATH=/

# Clerk authentication — client-side. Baked into the build at BUILD time,
# so these must be set before running `pnpm build` / `docker build`, not
# just at container runtime. Use the SAME production Clerk instance as
# CLERK_SECRET_KEY above.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
