{
  "name": "@workspace/prisma",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "push": "prisma db push --schema=./prisma/schema.prisma",
    "push:force": "prisma db push --schema=./prisma/schema.prisma --force-reset",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio --schema=./prisma/schema.prisma",
    "format": "prisma format --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "tsx": "catalog:"
  }
}
