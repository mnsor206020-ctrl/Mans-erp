modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22565
externalPort = 80

[userenv]

[userenv.shared]
BASE_PATH = "/"
CORS_ALLOWED_ORIGINS = "https://b69d6fca-4573-4f1f-8da6-f9977297ddc3-00-1u1ukfpz6jhn.pike.replit.dev"
LOG_LEVEL = "info"
