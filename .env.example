# ---------------------------------------------------------------------------
# Environment variables for `docker compose up`.
#
# Copy this file to `.env` and fill in real values. Never commit `.env` —
# it is (and must remain) git-ignored. No secrets are stored in this file.
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
# Credentials for the postgres service. Choose your own values; they are
# used to construct DATABASE_URL below and to initialize the postgres
# container on first boot.
POSTGRES_USER=mans_erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mans_erp

# --- api-server ---------------------------------------------------------------
# Port the API server listens on inside its container.
API_PORT=8080

# Full Postgres connection string used by Prisma. Must match the
# POSTGRES_* values above and the `postgres` service name (the Docker
# network's internal DNS hostname).
DATABASE_URL=postgresql://mans_erp:change-me@postgres:5432/mans_erp

# Clerk authentication (server-side). Get these from your Clerk dashboard.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated list of origins allowed to call the API (CORS allowlist).
# Should include the URL the frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Optional: logging verbosity (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# Optional: rate limiting overrides (sensible defaults are used if unset).
# RATE_LIMIT_GENERAL_MAX=600
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_WRITE_MAX=200
# RATE_LIMIT_WRITE_WINDOW_MS=900000
# RATE_LIMIT_SENSITIVE_MAX=60
# RATE_LIMIT_SENSITIVE_WINDOW_MS=900000

# --- mans-erp (frontend) ------------------------------------------------------
# Port the frontend preview server listens on inside its container.
WEB_PORT=8081

# Base path the app is served under. Use "/" unless deploying behind a
# path prefix (e.g. a reverse proxy that mounts the app at /app/).
BASE_PATH=/

# Clerk authentication (client-side, baked into the build at build time).
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
